<!-- FORMS SECTION -->
<section class="forms-section">
    <div class="contact-container">

    <!-- Tabs -->
    <div class="tabs-wrapper">
        <button class="tab-btn active" data-tab="message">
        <i class="fa-solid fa-paper-plane"></i> Enviar Mensaje
        </button>
        <button class="tab-btn" data-tab="login">
        <i class="fa-solid fa-right-to-bracket"></i> Iniciar Sesión
        </button>
    </div>

    <!-- TAB: MENSAJE -->
    <div class="tab-panel active" id="tab-message">
        <div class="form-card">
        <div class="form-header">
            <i class="fa-solid fa-paper-plane"></i>
            <div>
            <h2>Envíanos un Mensaje</h2>
            <p>Completa el formulario y te responderemos a la brevedad.</p>
            </div>
        </div>

        <form class="contact-form" id="messageForm" novalidate>
            <div class="form-row">
            <div class="form-group">
                <label for="nombre">
                <i class="fa-solid fa-user"></i> Nombre Completo
                </label>
                <input type="text" id="nombre" name="nombre" placeholder="Tu nombre completo" required/>
            </div>
            <div class="form-group">
                <label for="empresa">
                <i class="fa-solid fa-building"></i> Empresa (opcional)
                </label>
                <input type="text" id="empresa" name="empresa" placeholder="Nombre de tu empresa"/>
            </div>
            </div>

            <div class="form-row">
            <div class="form-group">
                <label for="email">
                <i class="fa-solid fa-envelope"></i> Correo Electrónico
                </label>
                <input type="email" id="email" name="email" placeholder="tu@correo.com" required/>
            </div>
            <div class="form-group">
                <label for="telefono">
                <i class="fa-solid fa-phone"></i> Teléfono
                </label>
                <input type="tel" id="telefono" name="telefono" placeholder="0000-0000"/>
            </div>
            </div>

            <div class="form-group">
            <label for="servicio">
                <i class="fa-solid fa-gears"></i> Servicio de Interés
            </label>
            <select id="servicio" name="servicio">
                <option value="">Selecciona un servicio...</option>
                <option value="preventivo">Mantenimiento Preventivo</option>
                <option value="soporte">Soporte Técnico</option>
                <option value="sostenibilidad">Sostenibilidad de Sistemas</option>
                <option value="seguridad">Seguridad Informática</option>
                <option value="cloud">Gestión en la Nube</option>
                <option value="red">Infraestructura de Red</option>
                <option value="backup">Respaldo y Recuperación</option>
                <option value="monitoreo">Monitoreo Continuo</option>
                <option value="otro">Otro / Consulta General</option>
            </select>
            </div>

            <div class="form-group">
            <label for="mensaje">
                <i class="fa-solid fa-comment-dots"></i> Mensaje
            </label>
            <textarea id="mensaje" name="mensaje" rows="5"
                placeholder="Describe tu situación o lo que necesitas. Mientras más detalle, mejor podemos ayudarte..." required></textarea>
            </div>

            <div class="form-footer-row">
            <p class="form-note">
                <i class="fa-solid fa-lock"></i>
                Tu información está protegida y no será compartida con terceros.
            </p>
            <button type="submit" class="btn btn-primary btn-submit">
                <i class="fa-solid fa-paper-plane"></i> Enviar Mensaje
            </button>
            </div>
        </form>

        <!-- Success message (hidden by default) -->
        <div class="success-msg" id="successMsg">
            <i class="fa-solid fa-circle-check"></i>
            <h3>¡Mensaje enviado!</h3>
            <p>Gracias por contactarnos. Te responderemos en menos de 2 horas hábiles.</p>
        </div>
        </div>
    </div>

    <!-- TAB: LOGIN -->
    <div class="tab-panel" id="tab-login">
        <div class="form-card login-card">
        <div class="form-header">
            <i class="fa-solid fa-right-to-bracket"></i>
            <div>
            <h2>Portal de Clientes</h2>
            <p>Accede a tu panel para ver tickets, reportes y estado de tus sistemas.</p>
            </div>
        </div>

        <form class="contact-form" id="loginForm" novalidate>
            <div class="form-group">
            <label for="loginEmail">
                <i class="fa-solid fa-envelope"></i> Correo Electrónico
            </label>
            <input type="email" id="loginEmail" name="loginEmail"
                placeholder="tu@correo.com" required/>
            </div>

            <div class="form-group">
            <label for="loginPass">
                <i class="fa-solid fa-lock"></i> Contraseña
            </label>
            <div class="pass-wrapper">
                <input type="password" id="loginPass" name="loginPass"
                placeholder="••••••••" required/>
                <button type="button" class="toggle-pass" id="togglePass" aria-label="Mostrar contraseña">
                <i class="fa-solid fa-eye" id="eyeIcon"></i>
                </button>
            </div>
            </div>

            <div class="form-check-row">
            <label class="check-label">
                <input type="checkbox" id="remember"/>
                <span><i class="fa-solid fa-circle-check"></i> Recordarme</span>
            </label>
            <a href="#" class="forgot-link">¿Olvidaste tu contraseña?</a>
            </div>

            <button type="submit" class="btn btn-primary btn-submit full-width">
            <i class="fa-solid fa-right-to-bracket"></i> Iniciar Sesión
            </button>

            <div class="divider-text"><span>¿No tienes cuenta?</span></div>

            <a href="#" class="btn btn-outline btn-submit full-width"
            style="justify-content:center; text-align:center;">
