        <div class="schedule-times">
            <div class="sched-row">
            <span><i class="fa-solid fa-phone"></i> Teléfono</span>
            <span class="sched-time"><a href="tel:60085743" style="color:var(--c1);text-decoration:none;">6008-5743</a></span>
